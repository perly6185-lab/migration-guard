{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "migration-guard://zboss-page/horizontal-list-request-v1",
  "title": "ZBoss horizontal list request",
  "type": "object",
  "required": ["horizontalId"],
  "properties": {
    "horizontalId": { "type": ["integer", "string"], "pattern": "^[1-9][0-9]*$" },
    "pageNo": { "type": ["integer", "null"], "minimum": 1 },
    "pageSize": { "type": ["integer", "null"], "minimum": 1, "maximum": 10000 },
    "operator": { "type": ["string", "null"] },
    "selectValues": { "type": "object" },
    "orderValues": { "type": "array" },
    "showArchived": { "type": ["boolean", "null"] }
  },
  "additionalProperties": true
}
