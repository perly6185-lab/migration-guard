ZBOSS_UNIFIED_BIND=127.0.0.1:18080
# Required only for a non-loopback bind. Inject through the deployment secret
# store; never commit the real value.
# ZBOSS_UNIFIED_PROXY_SHARED_SECRET=<configured-outside-repository>

# Dynamic Engine runtime
ZBOSS_PAGE_PROFILE=memory
ZBOSS_PAGE_MYSQL_URL=
ZBOSS_PAGE_REDIS_URL=
ZBOSS_PAGE_CATALOG_FILE=

# Batch delete: disabled or production
ZBOSS_UNIFIED_BATCH_DELETE_MODE=disabled
ZBOSS_BATCH_DELETE_MYSQL_URL=
ZBOSS_BATCH_DELETE_REDIS_URL=
ZBOSS_BATCH_DELETE_TABLE=
ZBOSS_BATCH_DELETE_LEASE_TTL_MS=30000
ZBOSS_BATCH_DELETE_WORKER_INTERVAL_MS=100

# Only required when running the legacy standalone batch-delete binary.
# ZBOSS_BATCH_DELETE_BIND_ADDR=127.0.0.1:18082

# Batch update remains contract-only/fail-closed in the unified runtime.
