{
  "name": "migration-guard",
  "version": "0.3.0-beta.1",
  "description": "A behavior-consistency guardrail CLI for refactoring and migration work.",
  "type": "module",
  "main": "dist/desktop/main.js",
  "bin": {
    "migration-guard": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node scripts/ci/run-tests.mjs",
    "ui:smoke": "npm run build && node scripts/smoke/ui-server-smoke.mjs",
    "desktop:dev": "npm run build && node scripts/desktop/electron-launch.mjs .",
    "desktop:smoke": "npm run build && node scripts/smoke/electron-desktop-smoke.mjs",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "start": "node dist/cli.js",
    "prepack": "npm run build",
    "package:smoke": "npm run build && node scripts/smoke/package-install-smoke.mjs",
    "package:golden": "npm run build && node scripts/smoke/golden-path-smoke.mjs",
    "pilot:smoke": "npm run build && node scripts/smoke/real-project-pilot.mjs",
    "method:pilot": "npm run build && node scripts/smoke/method-extraction-real-pilot.mjs",
    "package:audit": "npm run build && node scripts/ci/audit-package.mjs",
    "pilot:report": "node scripts/smoke/rc-feedback-report.mjs",
    "install:smoke": "npm run build && node scripts/smoke/install-modes-smoke.mjs",
    "release:gate": "node scripts/ci/release-gate.mjs",
    "release:candidate": "node scripts/release/candidate.mjs",
    "beta:readiness": "npm run build && node scripts/ci/beta-readiness.mjs",
    "semantic:gate": "npm run build && node dist/cli.js semantics validate && node dist/cli.js semantics validate --builtin builtin-java-core && node dist/cli.js semantics evaluate --samples fixtures/semantic/java-golden.json --min-coverage 100 --min-rule-coverage 25 --max-conflicts 0 --max-mismatches 0 && node dist/cli.js semantics evaluate --builtin builtin-java-core --samples fixtures/semantic/java-core-golden.json --min-coverage 100 --min-rule-coverage 55 --max-conflicts 0 --max-mismatches 0",
    "vmp:gate": "npm run build && node --test dist/core/vmpBehavior.test.js dist/core/vmpHorizontal.test.js dist/core/vmpQuality.test.js dist/core/vmpRefresh.test.js dist/core/vmpReplay.test.js dist/core/vmpArtifacts.test.js dist/core/vmpBatch.test.js dist/core/vmpContract.test.js && node dist/cli.js vmp fixtures && node dist/cli.js vmp contract",
    "dynamic-engine-rust:gate": "node rust/zboss-rust/internal/dynamic-engine-runtime/scripts/prp15-gate.mjs",
    "page-rust:gate": "npm run dynamic-engine-rust:gate",
    "page-rust:rb01-gate": "node rust/zboss-rust/internal/dynamic-engine-runtime/scripts/rb01-report-fill-gate.mjs",
    "page-rust:rb02-gate": "node rust/zboss-rust/internal/dynamic-engine-runtime/scripts/rb02-runtime-binding-gate.mjs",
    "page-rust:rb03-gate": "node rust/zboss-rust/internal/dynamic-engine-runtime/scripts/rb03-readonly-fixtures-gate.mjs",
    "page-rust:rb03-quality-diagnostic-gate": "node rust/zboss-rust/internal/dynamic-engine-runtime/scripts/rb03-quality-page-diagnostic-gate.mjs",
    "page-rust:rb03-upload-gate": "node rust/zboss-rust/internal/dynamic-engine-runtime/scripts/rb03-upload-analyze-gate.mjs",
    "page-rust:rb03-confirm-gate": "node rust/zboss-rust/internal/dynamic-engine-runtime/scripts/rb03-create-ledger-confirm-gate.mjs",
    "page-rust:rb04-confirm-contract-gate": "node rust/zboss-rust/internal/dynamic-engine-runtime/scripts/rb04-create-ledger-contract-gate.mjs",
    "batch-rust:l3-gate": "node rust/zboss-rust/internal/dynamic-engine-runtime/update/scripts/l3-gate.mjs",
    "batch-rust:container-gate": "node rust/zboss-rust/internal/dynamic-engine-runtime/update/scripts/container-adapter-gate.mjs",
    "batch-rust:l4b-gate": "npm run build && node rust/zboss-rust/internal/dynamic-engine-runtime/update/scripts/l4b-gate.mjs",
    "batch-rust:l4c-preflight": "node rust/zboss-rust/internal/dynamic-engine-runtime/update/scripts/l4c-real-replay.mjs",
    "batch-rust:l4c-run": "node rust/zboss-rust/internal/dynamic-engine-runtime/update/scripts/l4c-real-replay.mjs --execute",
    "batch-rust:l4c-self-test": "node rust/zboss-rust/internal/dynamic-engine-runtime/update/scripts/l4c-self-test.mjs",
    "batch-rust:l4c-process-self-test": "node rust/zboss-rust/internal/dynamic-engine-runtime/update/scripts/l4c-process-self-test.mjs",
    "batch-rust:l4c-environment-preflight": "node rust/zboss-rust/internal/dynamic-engine-runtime/update/scripts/l4c-environment-preflight.mjs",
    "batch-rust:l4c-environment-self-test": "node rust/zboss-rust/internal/dynamic-engine-runtime/update/scripts/l4c-environment-self-test.mjs",
    "batch-rust:l4c-plan-author": "node rust/zboss-rust/internal/dynamic-engine-runtime/update/scripts/l4c-plan-author.mjs",
    "batch-rust:sh3c-prepare": "node rust/zboss-rust/internal/dynamic-engine-runtime/update/scripts/l4c-scenario-promotion.mjs --write",
    "batch-rust:sh3c-gate": "node rust/zboss-rust/internal/dynamic-engine-runtime/update/scripts/l4c-scenario-promotion.mjs --check && node rust/zboss-rust/internal/dynamic-engine-runtime/update/scripts/l4c-scenario-promotion.mjs --self-test",
    "batch-rust:l4c-ci": "npm run batch-rust:l4c-self-test && npm run batch-rust:l4c-process-self-test && npm run batch-rust:l4c-environment-self-test && npm run batch-rust:sh3c-gate",
    "batch-rust:l4c-gate": "npm run build && node rust/zboss-rust/internal/dynamic-engine-runtime/update/scripts/l4c-gate.mjs",
    "batch-rust:trust-gate": "npm run build && node rust/zboss-rust/internal/dynamic-engine-runtime/update/scripts/trust-gate.mjs",
    "batch-delete-rust:l3-gate": "npm run build && node rust/zboss-rust/internal/dynamic-engine-runtime/delete/scripts/l3-gate.mjs",
    "batch-delete-rust:l4a-gate": "npm run build && node rust/zboss-rust/internal/dynamic-engine-runtime/delete/scripts/container-adapter-gate.mjs",
    "batch-delete-rust:trust-gate": "npm run build && node rust/zboss-rust/internal/dynamic-engine-runtime/delete/scripts/trust-gate.mjs",
    "batch-delete-rust:l4b-gate": "npm run build && node rust/zboss-rust/internal/dynamic-engine-runtime/delete/scripts/l4b-gate.mjs",
    "zboss-rust:gate": "node rust/zboss-rust/scripts/unified-gate.mjs",
    "zboss-rust:compatibility-gate": "node rust/zboss-rust/internal/dynamic-engine-runtime/scripts/compatibility-gate.mjs",
    "zboss-rust:completion-sync": "npm run build && node scripts/ci/zboss-completion-sync.mjs",
    "zboss-rust:compatibility-completion": "node scripts/ci/zboss-compatibility-completion.mjs",
    "zboss-rust:run": "cargo run --manifest-path rust/zboss-rust/Cargo.toml --bin zboss"
  },
  "keywords": [
    "migration",
    "refactoring",
    "verification",
    "baseline",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.20.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.migrationguard.desktop",
    "productName": "Migration Guard",
    "asar": true,
    "npmRebuild": false,
    "extraMetadata": {
      "main": "dist/desktop/main.js"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.test.js",
      "!dist/**/*.test.d.ts",
      "package.json",
      "README.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "fixtures/semantic/*.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/perly6185-lab/migration-guard.git"
  },
  "bugs": {
    "url": "https://github.com/perly6185-lab/migration-guard/issues"
  },
  "homepage": "https://github.com/perly6185-lab/migration-guard#readme"
}
