{
  "schemaVersion": 1,
  "ownershipPolicy": {
    "version": 1,
    "rules": []
  },
  "classifications": [
    {
      "id": "page-allocation-order-barrier",
      "symbolPattern": "AllocationOrderBarrier\\.(?:awaitTurn|signalDone)",
      "behavior": "coordination",
      "reason": "Coordinates deterministic allocation order between workers without owning business-state persistence."
    },
    {
      "id": "page-condition-clock-read",
      "symbolPattern": "ConditionValueParser\\.currentTimeMillis",
      "behavior": "clock-read",
      "reason": "Reads the current clock while resolving relative date conditions."
    },
    {
      "id": "page-temporal-calculation",
      "symbolPattern": "(?:DynamicDateOptionEnum\\.(?:mondayOf|point|quarter|range)|DynamicDateResolver\\.(?:chineseMonth|chineseYear|endOfDay|startOfDay)|LocalDate\\.(?:plusWeeks|with)|TemporalAdjusters\\.lastDayOfMonth|Year\\.(?:atDay|parse)|YearMonth\\.atDay)",
      "behavior": "calculation",
      "reason": "Performs deterministic date-range, boundary or calendar projection calculations over supplied values."
    },
    {
      "id": "page-expression-and-format-calculation",
      "symbolPattern": "(?:ColorAttributeDefaultFilter\\.sameColor|ColorEvaluationResult\\.(?:putBackground|putFont)|ConditionOperator\\.from|ConditionValueParser\\.(?:pad2|parseDateTimestamp|parseNumber|tryParseWithFormatter)|CrossTableAggregator\\.plain|DoubleBinOp\\.apply|JSON\\.parse|NumberFormat\\.parse|SafeExpressionEvaluator\\.(?:dateAdd|literalValue|stringify|truthy)|TEN\\.pow)",
      "behavior": "calculation",
      "reason": "Parses or calculates request-local values and response attributes without external I/O or durable mutation."
    },
    {
      "id": "page-number-comparison-normalization",
      "symbolPattern": "ExpValueFieldDataServiceImpl\\.toNumberComparisonValue",
      "behavior": "calculation",
      "reason": "Normalizes comparison input and delegates deterministic numeric formatting."
    },
    {
      "id": "page-color-filter-record-access",
      "symbolPattern": "rule\\.filterConditions",
      "behavior": "calculation",
      "reason": "Record accessor used by deterministic row color evaluation."
    },
    {
      "id": "page-refresh-lease",
      "symbolPattern": "(?:RedisViewMetaPageRefreshLockPortAdapter|ViewMetaPageRefreshLockPort)\\.",
      "behavior": "coordination",
      "reason": "Owner-token Redis lease acquisition and release are concurrency semantics."
    },
    {
      "id": "page-refresh-progress",
      "symbolPattern": "(?:ViewMetaRefreshSyncProgressService|ViewMetaRefreshSyncProgressPort)\\.",
      "behavior": "event-publish",
      "reason": "Refresh progress frames are externally observable event semantics."
    }
  ],
  "runtimeScenarios": [
    {
      "id": "calendar-view",
      "entrypointId": "post-zboss-data-view-dynamic-engine-use-engine-use-page-page",
      "title": "Calendar view page phase",
      "category": "compatibility",
      "requiredDimensions": [
        "http",
        "context",
        "decisions",
        "state",
        "performance"
      ],
      "reason": "Verify the page phase of the user-provided calendar workflow, including identity binding, temporal semantics and the 10000-row resource boundary."
    }
  ],
  "runtimeGates": [
    {
      "id": "page-pagination-baseline",
      "entrypointId": "post-zboss-data-view-dynamic-engine-use-engine-use-page-page",
      "scenarioPattern": ".*",
      "collectors": [],
      "gates": {
        "page": {
          "expectedStatus": 200,
          "requirePagination": true,
          "preserveRowOrder": true
        }
      },
      "decisionIds": []
    },
    {
      "id": "page-quality-query-shape",
      "entrypointId": "post-zboss-data-view-dynamic-engine-use-engine-use-page-page",
      "scenarioPattern": "^quality-",
      "collectors": [
        "sql-trace"
      ],
      "gates": {
        "page": {
          "requireTotalFilterParity": true
        }
      },
      "decisionIds": [
        "PAGE-DEC-QUALITY-AGGREGATE-ROUTING"
      ]
    },
    {
      "id": "page-horizontal-consistency",
      "entrypointId": "post-zboss-data-view-dynamic-engine-use-engine-use-page-page",
      "scenarioPattern": "^horizontal-",
      "collectors": [
        "sql-trace"
      ],
      "gates": {
        "page": {
          "requireTotalFilterParity": true,
          "requireHorizontalConsistency": true
        }
      },
      "decisionIds": [
        "PAGE-DEC-HORIZONTAL-HAVING"
      ]
    },
    {
      "id": "page-calendar-workflow",
      "entrypointId": "post-zboss-data-view-dynamic-engine-use-engine-use-page-page",
      "scenarioPattern": "^calendar-view$",
      "collectors": [
        "mysql",
        "sql-trace"
      ],
      "gates": {
        "page": {
          "expectedStatus": 200,
          "requirePagination": true,
          "preserveRowOrder": true,
          "requireTotalFilterParity": true
        }
      },
      "decisionIds": [
        "PAGE-DEC-CALENDAR-VIEW-TYPE-SOURCE",
        "PAGE-DEC-CALENDAR-QUERY-PAGE-BINDING",
        "PAGE-DEC-CALENDAR-PAGE-SIZE-10000",
        "PAGE-DEC-CALENDAR-TEMPORAL-SEMANTICS"
      ]
    },
    {
      "id": "page-refresh-trace",
      "entrypointId": "post-zboss-data-view-dynamic-engine-use-engine-use-page-page",
      "scenarioPattern": "^(?:refresh-.*|branch-coverage|dependency-failure|transaction-failure|concurrent-write)$",
      "collectors": [
        "events",
        "mysql",
        "redis",
        "sql-trace"
      ],
      "gates": {
        "page": {
          "requireRefreshTrace": true,
          "requireRefreshTerminal": true,
          "requireRefreshLock": true
        }
      },
      "decisionIds": [
        "PAGE-DEC-REFRESH-EFFECT-ORDER"
      ]
    },
    {
      "id": "page-transaction-self-call",
      "entrypointId": "post-zboss-data-view-dynamic-engine-use-engine-use-page-page",
      "scenarioPattern": "^transaction-failure$",
      "collectors": [
        "mysql"
      ],
      "gates": {
        "page": {
          "requireTotalFilterParity": true
        }
      },
      "decisionIds": [
        "PAGE-DEC-REQUIRES-NEW-SELF-CALL"
      ]
    }
  ]
}
