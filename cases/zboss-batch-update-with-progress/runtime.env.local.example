# Copy to runtime.env.local. The local file is git-ignored.
# Use only a dedicated disposable test identity; never use a production token.
MG_JAVA_TOKEN=
MG_JAVA_TENANT_ID=
MG_JAVA_USER_ID=

# Optional when the approved SSH/Nacos read-only collector bridge is used.
MG_JAVA_DATABASE_URL=
MG_JAVA_REDIS_URL=

# The selected scope must belong to MG_JAVA_TENANT_ID.
MG_JAVA_USE_PAGE_ID=
MG_JAVA_PAGE_ID=
MG_JAVA_PANEL_ID=

# Must be explicitly set to true before seed/invoke/cleanup may write fixture rows.
# Do not set this for panel 2059838046666665986: it is a non-disposable
# employee-attendance dataset and is currently approved for read-only discovery only.
MG_JAVA_FIXTURE_WRITE_APPROVED=false
