{
  "schemaVersion": 1,
  "protocol": "migration-guard.batch-update-l4c-bindings/v1",
  "status": "template",
  "projectId": "zboss-batch-update-with-progress",
  "targets": {
    "source": {
      "kind": "java",
      "stateProfileSha256": "<sha256-of-approved-java-state-profile.json>",
      "healthPath": "/actuator/health",
      "healthMethod": "GET",
      "acceptedHealthStatuses": [
        200
      ],
      "healthJsonPath": "status",
      "healthExpectedValue": "UP",
      "invokePath": "/zboss/data/view/dynamic/engine/use/engine-use-batch-page/batchUpdateWithProgress",
      "responseFields": {
        "code": "code",
        "message": "msg",
        "data": "data"
      },
      "timeoutMs": 120000,
      "hooks": {
        "doctor": {
          "program": "cargo",
          "args": [
            "run",
            "--quiet",
            "--manifest-path",
            "rust/zboss-rust/internal/dynamic-engine-runtime/Cargo.toml",
            "--bin",
            "zboss-l4c-java-state-hook",
            "--",
            "doctor"
          ],
          "requiresProfileHash": true
        },
        "seed": {
          "program": "cargo",
          "args": [
            "run",
            "--quiet",
            "--manifest-path",
            "rust/zboss-rust/internal/dynamic-engine-runtime/Cargo.toml",
            "--bin",
            "zboss-l4c-java-state-hook",
            "--",
            "seed"
          ],
          "requiresProfileHash": true,
          "requiresSeedProfileHash": true
        },
        "snapshot": {
          "program": "cargo",
          "args": [
            "run",
            "--quiet",
            "--manifest-path",
            "rust/zboss-rust/internal/dynamic-engine-runtime/Cargo.toml",
            "--bin",
            "zboss-l4c-java-state-hook",
            "--",
            "snapshot"
          ],
          "requiresProfileHash": true
        },
        "faultController": {
          "program": "<approved-java-fault-injector>",
          "args": [
            "{faultAction}",
            "{scenarioId}",
            "{marker}"
          ]
        },
        "collect": {
          "program": "cargo",
          "args": [
            "run",
            "--quiet",
            "--manifest-path",
            "rust/zboss-rust/internal/dynamic-engine-runtime/Cargo.toml",
            "--bin",
            "zboss-l4c-java-state-hook",
            "--",
            "collect"
          ],
          "requiresProfileHash": true
        },
        "cleanup": {
          "program": "cargo",
          "args": [
            "run",
            "--quiet",
            "--manifest-path",
            "rust/zboss-rust/internal/dynamic-engine-runtime/Cargo.toml",
            "--bin",
            "zboss-l4c-java-state-hook",
            "--",
            "cleanup"
          ],
          "requiresProfileHash": true
        },
        "verifyCleanup": {
          "program": "cargo",
          "args": [
            "run",
            "--quiet",
            "--manifest-path",
            "rust/zboss-rust/internal/dynamic-engine-runtime/Cargo.toml",
            "--bin",
            "zboss-l4c-java-state-hook",
            "--",
            "verify-cleanup"
          ],
          "requiresProfileHash": true
        }
      }
    },
    "target": {
      "kind": "rust",
      "healthPath": "/internal/ready",
      "healthMethod": "GET",
      "acceptedHealthStatuses": [
        200
      ],
      "healthJsonPath": "status",
      "healthExpectedValue": "ready",
      "invokePath": "/zboss/data/view/dynamic/engine/use/engine-use-batch-page/batchUpdateWithProgress",
      "responseFields": {
        "code": "code",
        "message": "message",
        "data": "data"
      },
      "timeoutMs": 120000,
      "hooks": {
        "doctor": {
          "program": "cargo",
          "args": [
            "run",
            "--quiet",
            "--manifest-path",
            "rust/zboss-rust/internal/dynamic-engine-runtime/Cargo.toml",
            "--bin",
            "zboss-l4c-state-hook",
            "--",
            "doctor",
            "zboss-evidence-v1"
          ]
        },
        "seed": {
          "program": "cargo",
          "args": [
            "run",
            "--quiet",
            "--manifest-path",
            "rust/zboss-rust/internal/dynamic-engine-runtime/Cargo.toml",
            "--bin",
            "zboss-l4c-state-hook",
            "--",
            "seed",
            "zboss-evidence-v1"
          ],
          "requiresSeedProfileHash": true
        },
        "snapshot": {
          "program": "cargo",
          "args": [
            "run",
            "--quiet",
            "--manifest-path",
            "rust/zboss-rust/internal/dynamic-engine-runtime/Cargo.toml",
            "--bin",
            "zboss-l4c-state-hook",
            "--",
            "snapshot",
            "zboss-evidence-v1"
          ]
        },
        "faultController": {
          "program": "<approved-rust-fault-injector>",
          "args": [
            "{faultAction}",
            "{scenarioId}",
            "{marker}"
          ]
        },
        "collect": {
          "program": "cargo",
          "args": [
            "run",
            "--quiet",
            "--manifest-path",
            "rust/zboss-rust/internal/dynamic-engine-runtime/Cargo.toml",
            "--bin",
            "zboss-l4c-state-hook",
            "--",
            "collect",
            "zboss-evidence-v1"
          ]
        },
        "cleanup": {
          "program": "cargo",
          "args": [
            "run",
            "--quiet",
            "--manifest-path",
            "rust/zboss-rust/internal/dynamic-engine-runtime/Cargo.toml",
            "--bin",
            "zboss-l4c-state-hook",
            "--",
            "cleanup",
            "zboss-evidence-v1"
          ]
        },
        "verifyCleanup": {
          "program": "cargo",
          "args": [
            "run",
            "--quiet",
            "--manifest-path",
            "rust/zboss-rust/internal/dynamic-engine-runtime/Cargo.toml",
            "--bin",
            "zboss-l4c-state-hook",
            "--",
            "verify-cleanup",
            "zboss-evidence-v1"
          ]
        }
      }
    }
  },
  "scenarios": {
    "<scenario-id>": {
      "seedProfiles": {
        "source": {
          "path": "cases/zboss-batch-update-with-progress/evidence/runtime/l4c/seeds/<scenario-id>.java-seed.json",
          "sha256": "<sha256-of-approved-java-seed-profile>"
        },
        "target": {
          "path": "cases/zboss-batch-update-with-progress/evidence/runtime/l4c/seeds/<scenario-id>.rust-seed.json",
          "sha256": "<sha256-of-approved-rust-seed-profile>"
        }
      },
      "request": {
        "shared": {
          "method": "POST",
          "headers": {
            "content-type": "application/json",
            "authorization": "${MG_JAVA_TOKEN}",
            "x-tenant-id": "{tenantId}",
            "x-user-id": "${MG_JAVA_USER_ID}",
            "x-request-id": "{marker}",
            "x-datasource": "${MG_L4C_DATASOURCE}"
          },
          "body": {
            "reqId": "{marker}",
            "panelId": "{panelId}"
          },
          "acceptedStatuses": [
            200
          ],
          "expectedRowCount": 0,
          "responseFields": [
            "code",
            "message",
            "data"
          ]
        }
      },
      "hooks": {}
    }
  }
}
