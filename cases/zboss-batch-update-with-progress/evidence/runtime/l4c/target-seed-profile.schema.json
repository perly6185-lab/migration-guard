{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "migration-guard.batch-update-l4c-target-seed/v1",
  "title": "L4-C Rust target seed profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocol",
    "status",
    "projectId",
    "targetKind",
    "scenarioId",
    "rows"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocol": {
      "const": "migration-guard.batch-update-l4c-target-seed/v1"
    },
    "status": { "const": "approved" },
    "projectId": { "const": "zboss-batch-update-with-progress" },
    "targetKind": { "const": "target" },
    "scenarioId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["markerSuffix", "values"],
        "properties": {
          "markerSuffix": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
          },
          "values": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 64,
            "propertyNames": {
              "pattern": "^[A-Za-z0-9_]{1,64}$"
            }
          }
        }
      }
    }
  }
}
