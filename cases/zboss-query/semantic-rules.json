{
  "schemaVersion": 1,
  "ownershipPolicy": {
    "version": 1,
    "rules": []
  },
  "classifications": [
    {
      "id": "query-sync-stage-presence-value",
      "symbolPattern": "SyncStagePresence\\.of",
      "behavior": "calculation",
      "reason": "Constructs an immutable sync-stage presence value from already loaded metadata without performing I/O or durable mutation."
    }
  ],
  "runtimeScenarios": [
    {
      "id": "calendar-view-query",
      "entrypointId": "post-zboss-data-view-dynamic-engine-use-engine-use-page-query",
      "title": "Calendar view metadata phase",
      "category": "compatibility",
      "requiredDimensions": [
        "http",
        "context",
        "decisions",
        "effects",
        "state",
        "failures"
      ],
      "reason": "Verify explicit usePageId/viewId binding, calendar type metadata, cache isolation and observable query-time self-healing effects."
    }
  ],
  "runtimeGates": [
    {
      "id": "query-page-baseline",
      "entrypointId": "post-zboss-data-view-dynamic-engine-use-engine-use-page-query",
      "scenarioPattern": ".*",
      "collectors": [
        "mysql",
        "sql-trace"
      ],
      "gates": {
        "page": {
          "expectedStatus": 200,
          "requirePagination": true,
          "preserveRowOrder": true
        }
      }
    },
    {
      "id": "query-cache-isolation",
      "entrypointId": "post-zboss-data-view-dynamic-engine-use-engine-use-page-query",
      "scenarioPattern": "^query-cache-isolation$",
      "collectors": [
        "mysql",
        "sql-trace"
      ],
      "gates": {
        "query": {
          "requireCacheIsolation": true
        }
      }
    },
    {
      "id": "query-calendar-view",
      "entrypointId": "post-zboss-data-view-dynamic-engine-use-engine-use-page-query",
      "scenarioPattern": "^calendar-view-query$",
      "collectors": [
        "mysql",
        "sql-trace"
      ],
      "gates": {
        "query": {
          "requireCacheIsolation": true,
          "requireRequestSemanticParity": true
        }
      },
      "decisionIds": [
        "QUERY-DEC-CALENDAR-VIEW-BINDING",
        "QUERY-DEC-CALENDAR-CACHE-ISOLATION"
      ]
    },
    {
      "id": "query-timeout-quiescence",
      "entrypointId": "post-zboss-data-view-dynamic-engine-use-engine-use-page-query",
      "scenarioPattern": "^query-timeout-quiescence$",
      "collectors": [
        "mysql",
        "events",
        "sql-trace"
      ],
      "gates": {
        "query": {
          "requireAsyncQuiescence": true
        }
      }
    },
    {
      "id": "query-effect-atomicity",
      "entrypointId": "post-zboss-data-view-dynamic-engine-use-engine-use-page-query",
      "scenarioPattern": "^query-effect-atomicity$",
      "collectors": [
        "mysql",
        "sql-trace"
      ],
      "gates": {
        "query": {
          "requireEffectAtomicity": true,
          "requireIdempotency": true
        }
      }
    },
    {
      "id": "query-entrypoint-parity",
      "entrypointId": "post-zboss-data-view-dynamic-engine-use-engine-use-page-query",
      "scenarioPattern": "^entrypoint-parity$",
      "collectors": [
        "mysql",
        "sql-trace"
      ],
      "gates": {
        "query": {
          "requireEntrypointParity": true
        }
      }
    },
    {
      "id": "query-request-semantic-parity",
      "entrypointId": "post-zboss-data-view-dynamic-engine-use-engine-use-page-query",
      "scenarioPattern": "^request-semantic-parity$",
      "collectors": [
        "mysql",
        "sql-trace"
      ],
      "gates": {
        "query": {
          "requireRequestSemanticParity": true
        }
      }
    }
  ]
}
