{
  "schemaVersion": 1,
  "projectId": "zboss-batch-delete",
  "source": {
    "root": "D:\\gitlab\\ia\\test_zboss\\zboss-cloud\\zboss-module-data",
    "access": "read-only",
    "directories": [
      "zboss-module-data-api/src/main/java",
      "zboss-module-data-domain/src/main/java",
      "zboss-module-data-infrastructure/src/main/java",
      "zboss-module-data-infrastructure/src/main/resources",
      "zboss-module-data-service/src/main/java",
      "zboss-module-data-service/src/main/resources",
      "zboss-module-data-type/src/main/java"
    ],
    "language": "java",
    "framework": "spring",
    "adapter": "java-spring"
  },
  "data": {
    "dialect": "mysql",
    "adapters": [
      "mybatis"
    ]
  },
  "entrypoints": [
    {
      "id": "post-zboss-data-view-dynamic-engine-use-engine-use-batch-page-batchDelete",
      "kind": "http-route",
      "method": "POST",
      "path": "/zboss/data/view/dynamic/engine/use/engine-use-batch-page/batchDelete"
    }
  ],
  "contexts": {
    "tenant": "required",
    "user": "required",
    "request": "required",
    "datasource": "required",
    "custom": [
      "panelId",
      "usePageId",
      "operationKind",
      "batchId"
    ]
  },
  "infrastructure": {
    "caches": [
      "Redis page-query cache"
    ],
    "locks": [
      "SyncTrigger(usePageId)"
    ],
    "events": [
      "batch-progress",
      "row-deleted-after-commit",
      "undo-anchor",
      "delete-audit"
    ],
    "externalServices": [
      "WebSocket-progress"
    ]
  },
  "target": {
    "language": "rust",
    "root": "../../rust/zboss-rust/internal/dynamic-engine-runtime",
    "serviceName": "zboss-batch-delete",
    "productionPath": {
      "requiredTraits": [
        "BatchDeleteStore",
        "ProgressSink",
        "CompensationOutbox"
      ],
      "requiredRouteFragments": [
        "/zboss/data/view/dynamic/engine/use/engine-use-batch-page/batchDelete"
      ]
    }
  },
  "compatibility": {
    "strict": true,
    "approvalRequired": true,
    "approvedCorrectionIds": [
      "BD-DEC-ROW-LIMIT",
      "BD-DEC-DUPLICATE-REPLAY",
      "BD-DEC-COMPENSATION-DURABILITY",
      "BD-DEC-PROGRESS-COMPLETENESS"
    ]
  }
}
